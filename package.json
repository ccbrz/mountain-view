{
  "name": "mountain-view",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:client": "pnpm --filter client run dev",
    "dev:server": "pnpm --filter server run dev",
    "build": "pnpm --filter client run build && pnpm --filter server run build",
    "start": "pnpm --filter server run start",
    "db:seed": "pnpm --filter server run seed",
    "format": "prettier --write \"client/src/**/*.{ts,tsx,css}\" \"client/tests/**/*.ts\" \"server/src/**/*.ts\"",
    "format:check": "prettier --check \"client/src/**/*.{ts,tsx,css}\" \"client/tests/**/*.ts\" \"server/src/**/*.ts\"",
    "typecheck": "pnpm --filter server run typecheck && pnpm --filter client exec tsc --noEmit",
    "test": "pnpm --filter server run test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "prettier": "3.3.3"
  }
}
